# Public HTTPS base URL where Twilio reaches this server (no trailing slash)
PUBLIC_BASE_URL=https://callfw.example.com

# Owner
OWNER_NAME=Rui
TIMEZONE=Europe/Madrid
# Quiet hours count as "busy" (HH:MM-HH:MM, empty to disable)
QUIET_HOURS=22:00-08:00

# Lines: one entry per Digi line -> Twilio number that receives its forwards
# Format: twilio_number|owner_mobile|language ; separated by commas
LINES=+34910000000|+34600000000|es-ES,+351210000000|+351910000000|pt-PT

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_VALIDATE_SIGNATURE=true

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-haiku-5-5

# Google (from scripts/google_auth.py)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REFRESH_TOKEN=xxxx

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_CHAT_ID=123456789
TELEGRAM_NOTIFY_BLOCKED=true

# Shared secret for the Android app (Authorization: Bearer ...)
APP_API_TOKEN=change-me-long-random

# Behaviour
SILENCE_TIMEOUT_S=10
MAX_CALL_S=150
TRANSFER_RING_S=12
DB_PATH=callfw.sqlite3
